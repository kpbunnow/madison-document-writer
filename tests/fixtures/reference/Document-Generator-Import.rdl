          <DataField>IndividualLandmark</DataField>
        </Field>
        <Field Name="InspectionDate">
          <rd:TypeName>System.DateTime</rd:TypeName>
          <DataField>InspectionDate</DataField>
        </Field>
        <Field Name="InspectionScheduledDate">
          <rd:TypeName>System.DateTime</rd:TypeName>
